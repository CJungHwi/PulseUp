## Architectural Patterns

### 1. Layered Architecture

**PRINCIPLE**: Separation of concerns through distinct layers.

```
┌─────────────────────────────────────┐
│   HTTP Request (Client)             │
└─────────────────┬───────────────────┘
                  │
┌─────────────────▼───────────────────┐
│   Middleware Chain                  │
│   • Authentication                  │
│   • Validation                      │
│   • Logging                         │
└─────────────────┬───────────────────┘
                  │
┌─────────────────▼───────────────────┐
│   Route Handler (Controller)        │
│   • Request parsing                 │
│   • Response formatting             │
│   • Thin layer (no business logic)  │
└─────────────────┬───────────────────┘
                  │
┌─────────────────▼───────────────────┐
│   Service Layer                     │
│   • Business logic                  │
│   • Data validation                 │
│   • Orchestration                   │
└─────────────────┬───────────────────┘
                  │
┌─────────────────▼───────────────────┐
│   Database / External Services      │
│   • Data persistence                │
│   • Third-party APIs                │
└─────────────────────────────────────┘
```

### 2. Route Handler Pattern

**PRINCIPLE**: Keep route handlers thin - delegate to services.

```typescript
// routes/users.routes.ts
import { Router } from 'express'
import { authenticateToken } from '../middleware/auth.middleware.js'
import { validateBody } from '../middleware/validation.middleware.js'
import { createUserSchema } from '../schemas/user.schema.js'
import { UserService } from '../services/user.service.js'

const router = Router()

// ✅ GOOD: Thin route handler
router.post(
  '/users',
  authenticateToken,                    // 1. Authentication
  validateBody(createUserSchema),       // 2. Validation
  async (req, res, next) => {           // 3. Handler
    try {
      const user = await UserService.createUser(req.body)
      res.status(201).json({
        success: true,
        data: user
      })
    } catch (error) {
      next(error)  // Pass to error middleware
    }
  }
)

export default router
```

```typescript
// ❌ BAD: Business logic in route handler
router.post('/users', async (req, res) => {
  const { email, password, name } = req.body
  
  // ❌ Validation in route
  if (!email || !password) {
    return res.status(400).json({ error: 'Missing fields' })
  }
  
  // ❌ Business logic in route
  const hashedPassword = await bcrypt.hash(password, 10)
  
  // ❌ Database access in route
  const result = await db.query(
    'INSERT INTO users (email, password, name) VALUES (?, ?, ?)',
    [email, hashedPassword, name]
  )
  
  res.json({ id: result.insertId })
})
```

### 3. Service Layer Pattern

**PRINCIPLE**: Encapsulate business logic in services.

```typescript
// services/user.service.ts
import { executeQuery, callProcedure } from '../lib/database.js'
import { hashPassword } from '../utils/hash.util.js'

export class UserService {
  /**
   * Create a new user
   */
  static async createUser(data: {
    email: string
    password: string
    name: string
    role?: string
  }) {
    // Business logic: Hash password
    const hashedPassword = await hashPassword(data.password)
    
    // Business logic: Set default role
    const role = data.role || 'user'
    
    // Database operation
    const [result] = await executeQuery(
      `INSERT INTO users (email, password, name, role, created_at) 
       VALUES (?, ?, ?, ?, NOW())`,
      [data.email, hashedPassword, data.name, role]
    )
    
    // Return clean data (no password)
    return {
      id: result.insertId,
      email: data.email,
      name: data.name,
      role
    }
  }
  
  /**
   * Find user by email
   */
  static async findByEmail(email: string) {
    const [users] = await executeQuery(
      'SELECT * FROM users WHERE email = ? AND deleted_at IS NULL',
      [email]
    )
    return users[0] || null
  }
  
  /**
   * Update user profile
   */
  static async updateProfile(userId: string, data: {
    name?: string
    phone?: string
  }) {
    const updates: string[] = []
    const params: any[] = []
    
    if (data.name !== undefined) {
      updates.push('name = ?')
      params.push(data.name)
    }
    
    if (data.phone !== undefined) {
      updates.push('phone = ?')
      params.push(data.phone)
    }
    
    if (updates.length === 0) {
      throw new Error('No fields to update')
    }
    
    params.push(userId)
    
    await executeQuery(
      `UPDATE users SET ${updates.join(', ')}, updated_at = NOW() WHERE id = ?`,
      params
    )
    
    return this.findById(userId)
  }
  
  /**
   * Soft delete user
   */
  static async deleteUser(userId: string) {
    await executeQuery(
      'UPDATE users SET deleted_at = NOW() WHERE id = ?',
      [userId]
    )
  }
  
  // Private helper
  private static async findById(id: string) {
    const [users] = await executeQuery(
      'SELECT id, email, name, role FROM users WHERE id = ? AND deleted_at IS NULL',
      [id]
    )
    return users[0] || null
  }
}
```

**KEY POINTS**:
- Static methods for stateless operations
- Single responsibility per method
- Return sanitized data (no passwords)
- Use private helpers for DRY
- Throw errors for exceptional cases
- Let middleware handle error responses

### 4. Middleware Chain Pattern

**PRINCIPLE**: Compose functionality through middleware.

```typescript
// middleware/auth.middleware.ts
import { Request, Response, NextFunction } from 'express'
import { verifyToken } from '../utils/jwt.util.js'
import { AuthService } from '../services/auth.service.js'

export interface AuthenticatedRequest extends Request {
  user?: {
    id: string
    email: string
    role: string
  }
}

/**
 * Verify JWT token and attach user to request
 */
export const authenticateToken = async (
  req: AuthenticatedRequest,
  res: Response,
  next: NextFunction
) => {
  try {
    const authHeader = req.headers['authorization']
    
    if (!authHeader || !authHeader.startsWith('Bearer ')) {
      return res.status(401).json({
        success: false,
        error: 'Access token required',
        code: 'TOKEN_REQUIRED'
      })
    }
    
    const token = authHeader.substring(7) // Remove 'Bearer '
    
    // Verify JWT
    const decoded = verifyToken(token)
    
    // Get user from database (verify still exists and active)
    const user = await AuthService.getUserById(decoded.userId)
    
    if (!user) {
      return res.status(401).json({
        success: false,
        error: 'Invalid token',
        code: 'INVALID_TOKEN'
      })
    }
    
    // Attach user to request
    req.user = {
      id: user.id,
      email: user.email,
      role: user.role
    }
    
    next()
  } catch (error) {
    if (error.name === 'TokenExpiredError') {
      return res.status(401).json({
        success: false,
        error: 'Token expired',
        code: 'TOKEN_EXPIRED'
      })
    }
    
    next(error)
  }
}

/**
 * Check if user has required role
 */
export const requireRole = (...allowedRoles: string[]) => {
  return (req: AuthenticatedRequest, res: Response, next: NextFunction) => {
    if (!req.user) {
      return res.status(401).json({
        success: false,
        error: 'Authentication required',
        code: 'AUTH_REQUIRED'
      })
    }
    
    if (!allowedRoles.includes(req.user.role)) {
      return res.status(403).json({
        success: false,
        error: 'Insufficient permissions',
        code: 'FORBIDDEN'
      })
    }
    
    next()
  }
}
```

**USAGE**:

```typescript
// Apply middleware in order
router.post(
  '/admin/users',
  authenticateToken,              // 1. Verify JWT
  requireRole('admin', 'super'),  // 2. Check role
  validateBody(schema),           // 3. Validate input
  handler                         // 4. Execute logic
)
```

### 5. Validation Pattern with Zod

**PRINCIPLE**: Validate all inputs at API boundary.

```typescript
// schemas/user.schema.ts
import { z } from 'zod'

export const createUserSchema = z.object({
  email: z.string().email('Invalid email format'),
  password: z.string()
    .min(8, 'Password must be at least 8 characters')
    .regex(/[A-Z]/, 'Password must contain uppercase letter')
    .regex(/[a-z]/, 'Password must contain lowercase letter')
    .regex(/[0-9]/, 'Password must contain number'),
  name: z.string().min(1, 'Name is required').max(100),
  role: z.enum(['user', 'admin']).optional(),
  phone: z.string().regex(/^\+?[1-9]\d{9,14}$/).optional()
})

export const updateUserSchema = z.object({
  name: z.string().min(1).max(100).optional(),
  phone: z.string().regex(/^\+?[1-9]\d{9,14}$/).optional()
}).refine(data => Object.keys(data).length > 0, {
  message: 'At least one field must be provided'
})

export const loginSchema = z.object({
  email: z.string().email(),
  password: z.string().min(1)
})

// Type inference
export type CreateUserInput = z.infer<typeof createUserSchema>
export type UpdateUserInput = z.infer<typeof updateUserSchema>
export type LoginInput = z.infer<typeof loginSchema>
```

```typescript
// middleware/validation.middleware.ts
import { Request, Response, NextFunction } from 'express'
import { z } from 'zod'

/**
 * Validate request body against Zod schema
 */
export const validateBody = (schema: z.ZodSchema) => {
  return (req: Request, res: Response, next: NextFunction) => {
    try {
      req.body = schema.parse(req.body)
      next()
    } catch (error) {
      if (error instanceof z.ZodError) {
        return res.status(400).json({
          success: false,
          error: 'Validation failed',
          code: 'VALIDATION_ERROR',
          details: error.errors.map(err => ({
            field: err.path.join('.'),
            message: err.message
          }))
        })
      }
      next(error)
    }
  }
}

/**
 * Validate request params
 */
export const validateParams = (schema: z.ZodSchema) => {
  return (req: Request, res: Response, next: NextFunction) => {
    try {
      req.params = schema.parse(req.params)
      next()
    } catch (error) {
      if (error instanceof z.ZodError) {
        return res.status(400).json({
          success: false,
          error: 'Invalid parameters',
          code: 'INVALID_PARAMS',
          details: error.errors
        })
      }
      next(error)
    }
  }
}

/**
 * Validate request query
 */
export const validateQuery = (schema: z.ZodSchema) => {
  return (req: Request, res: Response, next: NextFunction) => {
    try {
      req.query = schema.parse(req.query)
      next()
    } catch (error) {
      if (error instanceof z.ZodError) {
        return res.status(400).json({
          success: false,
          error: 'Invalid query parameters',
          code: 'INVALID_QUERY',
          details: error.errors
        })
      }
      next(error)
    }
  }
}
```

