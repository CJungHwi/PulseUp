## Application Lifecycle

```typescript
// main.ts
import { app, BrowserWindow } from 'electron'
import { DisplayManager } from './main/display-manager'
import { LocalServer } from './main/local-server'

let displayManager: DisplayManager
let localServer: LocalServer

// Single instance lock
const gotTheLock = app.requestSingleInstanceLock()

if (!gotTheLock) {
  app.quit()
} else {
  app.on('second-instance', (event, commandLine, workingDirectory) => {
    // Someone tried to run a second instance, focus our windows
    const windows = BrowserWindow.getAllWindows()
    if (windows.length > 0) {
      windows[0].focus()
    }
  })
  
  app.on('ready', async () => {
    try {
      // Initialize display manager
      displayManager = new DisplayManager()
      await displayManager.createMultiDisplayWindows()
      displayManager.setupDisplayListeners()
      
      // Start local server
      localServer = new LocalServer(3002)
      await localServer.start()
      
      console.log('Application ready')
    } catch (error) {
      console.error('Initialization failed:', error)
      app.quit()
    }
  })
  
  app.on('window-all-closed', () => {
    if (process.platform !== 'darwin') {
      app.quit()
    }
  })
  
  app.on('activate', () => {
    if (BrowserWindow.getAllWindows().length === 0) {
      displayManager.createMultiDisplayWindows()
    }
  })
  
  app.on('before-quit', async () => {
    // Cleanup
    if (localServer) {
      await localServer.stop()
    }
    if (displayManager) {
      displayManager.destroy()
    }
  })
}
```

