## Security Architecture

### PRINCIPLE: Defense in Depth

Electron applications are vulnerable to XSS, remote code execution, and privilege escalation if not properly secured. Follow these rules strictly.

### 1. Process Isolation

**CRITICAL RULES**:

```typescript
// main.ts - Window creation with secure defaults
const mainWindow = new BrowserWindow({
  width: 1200,
  height: 800,
  webPreferences: {
    preload: path.join(__dirname, '../preload/preload.js'),
    
    // SECURITY: Disable dangerous features
    nodeIntegration: false,           // ✅ REQUIRED
    contextIsolation: true,           // ✅ REQUIRED
    sandbox: true,                    // ✅ RECOMMENDED
    
    // SECURITY: Prevent remote content execution
    webSecurity: true,                // ✅ REQUIRED
    allowRunningInsecureContent: false, // ✅ REQUIRED
    
    // SECURITY: Disable navigation to external URLs
    enableRemoteModule: false,        // ✅ REQUIRED (deprecated but check)
  },
})
```

**EXPLANATION**:
- `nodeIntegration: false` - Prevents renderer from accessing Node.js APIs directly
- `contextIsolation: true` - Separates preload script context from renderer
- `sandbox: true` - Runs renderer in OS-level sandbox
- `webSecurity: true` - Enforces same-origin policy

### 2. IPC Communication

**SECURE PATTERN**: Use `contextBridge` to expose limited APIs.

```typescript
// preload.ts - Secure IPC bridge
import { contextBridge, ipcRenderer } from 'electron'

// Define allowed channels
const ALLOWED_CHANNELS = {
  send: [
    'window:minimize',
    'window:maximize',
    'window:close',
    'device:connect',
    'device:disconnect',
  ],
  invoke: [
    'device:list',
    'file:save',
    'file:load',
  ],
  on: [
    'device:data',
    'update:available',
    'update:progress',
  ],
}

// Expose secure API
contextBridge.exposeInMainWorld('electronAPI', {
  // Send one-way messages
  send: (channel: string, ...args: any[]) => {
    if (ALLOWED_CHANNELS.send.includes(channel)) {
      ipcRenderer.send(channel, ...args)
    } else {
      console.error(`Unauthorized IPC channel: ${channel}`)
    }
  },
  
  // Invoke with promise-based response
  invoke: async (channel: string, ...args: any[]) => {
    if (ALLOWED_CHANNELS.invoke.includes(channel)) {
      return await ipcRenderer.invoke(channel, ...args)
    } else {
      throw new Error(`Unauthorized IPC channel: ${channel}`)
    }
  },
  
  // Register event listeners
  on: (channel: string, callback: (...args: any[]) => void) => {
    if (ALLOWED_CHANNELS.on.includes(channel)) {
      const subscription = (_event: any, ...args: any[]) => callback(...args)
      ipcRenderer.on(channel, subscription)
      
      // Return cleanup function
      return () => {
        ipcRenderer.removeListener(channel, subscription)
      }
    } else {
      console.error(`Unauthorized IPC channel: ${channel}`)
      return () => {}
    }
  },
})

// Type definitions for TypeScript
export interface ElectronAPI {
  send: (channel: string, ...args: any[]) => void
  invoke: (channel: string, ...args: any[]) => Promise<any>
  on: (channel: string, callback: (...args: any[]) => void) => () => void
}

declare global {
  interface Window {
    electronAPI: ElectronAPI
  }
}
```

```typescript
// main/ipc-handlers.ts - Validate all inputs
import { ipcMain } from 'electron'
import { z } from 'zod'

// Input validation schemas
const connectDeviceSchema = z.object({
  deviceId: z.string().min(1),
  config: z.object({
    baudRate: z.number().min(300).max(115200).optional(),
  }).optional(),
})

// Register handlers with validation
ipcMain.handle('device:connect', async (event, payload) => {
  try {
    // SECURITY: Validate input
    const validated = connectDeviceSchema.parse(payload)
    
    // SECURITY: Check window origin
    const sender = event.sender
    if (!isWindowAllowed(sender)) {
      throw new Error('Unauthorized window')
    }
    
    // Business logic
    const result = await deviceManager.connect(validated.deviceId, validated.config)
    
    return { success: true, data: result }
  } catch (error) {
    console.error('device:connect error:', error)
    return { success: false, error: error.message }
  }
})

function isWindowAllowed(sender: Electron.WebContents): boolean {
  const url = sender.getURL()
  // Only allow local URLs
  return url.startsWith('file://') || url.startsWith('http://localhost:')
}
```

**USAGE IN RENDERER**:

```typescript
// renderer/components/DeviceControl.tsx
const DeviceControl = () => {
  const [devices, setDevices] = useState([])
  
  useEffect(() => {
    // Fetch device list
    window.electronAPI.invoke('device:list')
      .then(result => {
        if (result.success) {
          setDevices(result.data)
        }
      })
    
    // Listen for device data
    const cleanup = window.electronAPI.on('device:data', (data) => {
      console.log('Device data:', data)
    })
    
    return cleanup
  }, [])
  
  const handleConnect = async (deviceId: string) => {
    const result = await window.electronAPI.invoke('device:connect', {
      deviceId,
      config: { baudRate: 9600 }
    })
    
    if (!result.success) {
      console.error('Connection failed:', result.error)
    }
  }
  
  return <div>{/* UI */}</div>
}
