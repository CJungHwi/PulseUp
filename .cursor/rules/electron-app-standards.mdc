## Multi-Window & Display Management

### PRINCIPLE: Graceful degradation across monitor configurations.

```typescript
// main/display-manager.ts
import { screen, BrowserWindow } from 'electron'

export class DisplayManager {
  private windows: Map<string, BrowserWindow> = new Map()
  
  /**
   * Create windows across multiple displays
   * Fallback to single display if not enough monitors
   */
  async createMultiDisplayWindows(): Promise<void> {
    const displays = screen.getAllDisplays()
    
    if (displays.length === 0) {
      throw new Error('No displays detected')
    }
    
    // Define window configurations
    const windowConfigs = [
      { id: 'left', route: '/left', display: 0 },
      { id: 'center', route: '/center', display: 1 },
      { id: 'right', route: '/right', display: 2 },
    ]
    
    for (const config of windowConfigs) {
      // Fallback to primary display if target display doesn't exist
      const targetDisplay = displays[config.display] || displays[0]
      
      const window = new BrowserWindow({
        x: targetDisplay.bounds.x,
        y: targetDisplay.bounds.y,
        width: targetDisplay.bounds.width,
        height: targetDisplay.bounds.height,
        fullscreen: true,
        frame: false,
        webPreferences: {
          preload: path.join(__dirname, '../preload/preload.js'),
          nodeIntegration: false,
          contextIsolation: true,
        },
      })
      
      // Load content
      if (app.isPackaged) {
        window.loadFile(path.join(__dirname, '../renderer/index.html'), {
          hash: config.route,
        })
      } else {
        window.loadURL(`http://localhost:3002${config.route}`)
      }
      
      this.windows.set(config.id, window)
    }
  }
  
  /**
   * Handle display changes (connect/disconnect)
   */
  setupDisplayListeners(): void {
    screen.on('display-added', () => {
      console.log('Display added')
      this.repositionWindows()
    })
    
    screen.on('display-removed', () => {
      console.log('Display removed')
      this.repositionWindows()
    })
  }
  
  private repositionWindows(): void {
    // Reposition windows when display configuration changes
    // Ensure windows don't get lost on disconnected monitors
    const displays = screen.getAllDisplays()
    const primaryDisplay = screen.getPrimaryDisplay()
    
    this.windows.forEach((window) => {
      const bounds = window.getBounds()
      const currentDisplay = screen.getDisplayNearestPoint({
        x: bounds.x,
        y: bounds.y,
      })
      
      // If window is on disconnected display, move to primary
      if (!displays.includes(currentDisplay)) {
        window.setBounds({
          x: primaryDisplay.bounds.x,
          y: primaryDisplay.bounds.y,
          width: bounds.width,
          height: bounds.height,
        })
      }
    })
  }
  
  /**
   * Broadcast message to all windows
   */
  broadcast(channel: string, ...args: any[]): void {
    this.windows.forEach((window) => {
      if (!window.isDestroyed()) {
        window.webContents.send(channel, ...args)
      }
    })
  }
  
  /**
   * Send message to specific window
   */
  sendToWindow(windowId: string, channel: string, ...args: any[]): void {
    const window = this.windows.get(windowId)
    if (window && !window.isDestroyed()) {
      window.webContents.send(channel, ...args)
    }
  }
  
  /**
   * Cleanup
   */
  destroy(): void {
    this.windows.forEach((window) => {
      if (!window.isDestroyed()) {
        window.close()
      }
    })
    this.windows.clear()
  }
}
```

**USAGE**:

```typescript
// main.ts
import { DisplayManager } from './main/display-manager'

let displayManager: DisplayManager

app.on('ready', async () => {
  displayManager = new DisplayManager()
  await displayManager.createMultiDisplayWindows()
  displayManager.setupDisplayListeners()
  
  // Broadcast to all windows
  displayManager.broadcast('app:ready', { timestamp: Date.now() })
})
