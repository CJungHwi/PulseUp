## Hardware Device Integration

### PRINCIPLE: Isolate device logic in dedicated managers.

```typescript
// main/device-manager.ts
import HID from 'node-hid'
import { EventEmitter } from 'events'

export interface DeviceConfig {
  vendorId: number
  productId: number
}

export class DeviceManager extends EventEmitter {
  private device: HID.HID | null = null
  private isConnected: boolean = false
  
  /**
   * List available HID devices
   */
  listDevices(): HID.Device[] {
    try {
      return HID.devices()
    } catch (error) {
      console.error('Failed to list devices:', error)
      return []
    }
  }
  
  /**
   * Connect to device
   */
  async connect(config: DeviceConfig): Promise<void> {
    if (this.isConnected) {
      throw new Error('Device already connected')
    }
    
    try {
      // Find device
      const devices = HID.devices()
      const targetDevice = devices.find(
        (d) => d.vendorId === config.vendorId && d.productId === config.productId
      )
      
      if (!targetDevice || !targetDevice.path) {
        throw new Error('Device not found')
      }
      
      // Open device
      this.device = new HID.HID(targetDevice.path)
      this.isConnected = true
      
      // Setup data listener
      this.device.on('data', (data: Buffer) => {
        this.handleDeviceData(data)
      })
      
      this.device.on('error', (error: Error) => {
        console.error('Device error:', error)
        this.emit('error', error)
      })
      
      this.emit('connected', { config })
    } catch (error) {
      console.error('Failed to connect:', error)
      throw error
    }
  }
  
  /**
   * Process incoming device data
   */
  private handleDeviceData(data: Buffer): void {
    try {
      // Parse device protocol
      const parsed = this.parseDeviceData(data)
      this.emit('data', parsed)
    } catch (error) {
      console.error('Failed to parse device data:', error)
    }
  }
  
  /**
   * Parse device-specific data format
   */
  private parseDeviceData(data: Buffer): any {
    // Implement device-specific protocol parsing
    return {
      timestamp: Date.now(),
      raw: data.toString('hex'),
      // ... parsed fields
    }
  }
  
  /**
   * Send data to device
   */
  async send(data: Buffer): Promise<void> {
    if (!this.device || !this.isConnected) {
      throw new Error('Device not connected')
    }
    
    return new Promise((resolve, reject) => {
      this.device!.write(Array.from(data), (error) => {
        if (error) {
          reject(error)
        } else {
          resolve()
        }
      })
    })
  }
  
  /**
   * Disconnect device
   */
  disconnect(): void {
    if (this.device) {
      try {
        this.device.close()
      } catch (error) {
        console.error('Error closing device:', error)
      }
      this.device = null
      this.isConnected = false
      this.emit('disconnected')
    }
  }
  
  /**
   * Cleanup
   */
  destroy(): void {
    this.disconnect()
    this.removeAllListeners()
  }
}
```

**USAGE IN MAIN PROCESS**:

```typescript
// main/ipc-handlers.ts
import { DeviceManager } from './device-manager'

const deviceManager = new DeviceManager()

// Setup device event forwarding
deviceManager.on('data', (data) => {
  // Forward to all renderer windows
  BrowserWindow.getAllWindows().forEach((window) => {
    window.webContents.send('device:data', data)
  })
})

ipcMain.handle('device:connect', async (_event, config) => {
  try {
    await deviceManager.connect(config)
    return { success: true }
  } catch (error) {
    return { success: false, error: error.message }
  }
})

ipcMain.handle('device:disconnect', async () => {
  deviceManager.disconnect()
  return { success: true }
})
