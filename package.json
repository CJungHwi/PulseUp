{
  "name": "multi-monitor-workout-system",
  "version": "1.0.0",
  "description": "Multi-monitor workout system with web management and Electron app",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:web\"",
    "dev:all": "concurrently \"npm run dev:api\" \"npm run dev:web\" \"npm run dev:electron\"",
    "dev:web": "npm run dev --workspace=web-app",
    "dev:api": "npm run dev --workspace=api-server",
    "dev:electron": "npm run dev --workspace=electron-app",
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces",
    "lint": "npm run lint --workspaces",
    "build:api": "cross-env NODE_OPTIONS=\"--max-old-space-size=1843\" npm run build --workspace=api-server",
    "build:web": "cross-env NODE_OPTIONS=\"--max-old-space-size=1843\" npm run build --workspace=web-app",
    "dist:electron:win": "npm run dist:win --workspace=electron-app",
    "publish:electron:installer": "node build-scripts/publish-electron-installer.js",
    "release:electron:win": "npm run dist:electron:win && npm run publish:electron:installer",
    "install:all": "npm install"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "autoprefixer": "^10.4.23",
    "concurrently": "^9.2.0",
    "cross-env": "^10.1.0",
    "eslint": "^8.0.0",
    "postcss": "^8.5.6",
    "prettier": "^3.0.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@radix-ui/react-switch": "^1.2.6",
    "dayjs": "^1.11.19"
  }
}
