# MariaDB Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=workout_system

# API Server Configuration
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
# 공개 이미지 URL의 도메인 (모니터 기본 이미지 업로드 시 DB에 저장되는 주소의 origin)
# 미설정 시 기본값은 https://linkhiit.co.kr 입니다. 스테이징 등 다른 도메인이면 여기서 지정합니다.
# API_BASE_URL=https://linkhiit.co.kr
# 또는 동일 목적: PUBLIC_UPLOAD_BASE_URL=https://linkhiit.co.kr
#
# 실제 파일은 프로세스 기준 packages/api-server/uploads/ 루트에 저장됩니다(모니터 기본 이미지 등).
# Express에서 app.use('/uploads', express.static(...))로 서빙되므로, 운영에서는 Nginx 등으로
# /uploads 를 해당 디렉터리에 매핑하거나, API 서버가 정적 파일을 그대로 제공하면 됩니다.

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# YouTube API (선택사항)
YOUTUBE_API_KEY=your_youtube_api_key