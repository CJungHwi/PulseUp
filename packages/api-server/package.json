{
  "name": "api-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc --build --force",
    "start": "node dist/index.js",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:admin": "vitest --run src/tests/admin.test.ts",
    "test:admin-e2e": "vitest --run src/tests/admin-e2e.test.ts",
    "test:admin-security": "vitest --run src/tests/admin-security.test.ts",
    "test:admin-all": "vitest --run src/tests/admin*.test.ts",
    "lint": "eslint . --ext ts --report-unused-disable-directives --max-warnings 0",
    "db:setup": "mysql -u root -p < database/schema.sql",
    "db:procedures": "mysql -u root -p workout_system < database/procedures.sql",
    "db:workout-settings-procedures": "mysql -u root -p workout_system < database/workout-settings-procedures.sql",
    "db:init": "npm run db:setup && npm run db:procedures && npm run db:workout-settings-procedures",
    "db:test": "node test-db-connection.js",
    "db:setup-windows": "powershell -ExecutionPolicy Bypass -File database/setup-windows.ps1",
    "db:migrate": "node run-migration.js"
  },
  "dependencies": {
    "bcrypt": "^5.1.0",
    "cors": "^2.8.0",
    "dotenv": "^16.0.0",
    "express": "^4.18.0",
    "googleapis": "^118.0.0",
    "helmet": "^6.0.0",
    "jsonwebtoken": "^9.0.0",
    "multer": "^2.1.1",
    "mysql2": "^3.14.3",
    "ws": "^8.16.0",
    "zod": "^3.20.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.0",
    "@types/cors": "^2.8.0",
    "@types/express": "^4.17.0",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/multer": "^2.1.0",
    "@types/node": "^20.0.0",
    "@types/supertest": "^2.0.0",
    "@types/ws": "^8.5.10",
    "@typescript-eslint/eslint-plugin": "^5.0.0",
    "@typescript-eslint/parser": "^5.0.0",
    "eslint": "^8.0.0",
    "supertest": "^6.3.0",
    "tsx": "^3.12.0",
    "typescript": "^5.0.0",
    "vitest": "^0.34.0"
  }
}
