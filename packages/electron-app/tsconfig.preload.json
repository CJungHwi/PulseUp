{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist/preload",
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",
    "allowSyntheticDefaultImports": true,
    "noEmit": false
  },
  "include": [
    "src/preload.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "src/main",
    "src/renderer"
  ]
}